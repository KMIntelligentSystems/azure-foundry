# syntax=docker/dockerfile:1
# ACA synchronous WebSocket gateway + the same in-process orchestrator runtime.
FROM node:24-bookworm AS build
WORKDIR /src
COPY package*.json ./
RUN npm ci
COPY tsconfig.json tsconfig.agent.json ./
COPY src ./src
RUN npx tsc -p tsconfig.agent.json

FROM node:24-bookworm
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --break-system-packages --no-cache-dir \
      numpy==1.26.4 pandas==2.2.2 statsmodels==0.14.6 scikit-learn==1.5.2
COPY --from=build /src/dist ./dist
COPY src/hosted-agent/agents ./dist/hosted-agent/agents
COPY src/hosted-agent/skills ./dist/hosted-agent/skills
COPY --from=build /src/node_modules ./node_modules
RUN npx playwright install --with-deps chromium
ENV PORT=8080 PYTHON_BIN=python3
EXPOSE 8080
CMD ["node", "dist/aca-gateway/server.js"]
