# Copy to .env and fill in. Never put real secrets in this file — it is committed.

# Azure AI Foundry project endpoint.
# Portal: your project > Overview > "Azure AI Foundry project endpoint"
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=

# Model deployment name (not the model name) from Models + endpoints.
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# React production build: direct ACA synchronous WebSocket gateway + Entra SPA.
VITE_AGENT_WS_URL=wss://<aca-gateway-fqdn>/ws/agent
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_GATEWAY_SCOPE=api://<gateway-api-client-id>/access_as_user

# ACA gateway: exact comma-separated browser origins permitted to connect.
ALLOWED_ORIGINS=https://<your-static-web-app>.azurestaticapps.net
# Entra application/client ID accepted as the browser token audience.
ACA_GATEWAY_CLIENT_ID=
ENTRA_TENANT_ID=
# Comma-separated Entra object IDs whose catalog identity maps to "admin".
ADMIN_OBJECT_IDS=
# Local development only; never enable on the production ACA revision.
ALLOW_INSECURE_USER_ID=false

# Required by src/aca.ts (Container Apps management plane).
AZURE_SUBSCRIPTION_ID=

# Optional: only needed if `az login` picks the wrong tenant.
# AZURE_TENANT_ID=
