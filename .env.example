# Copy to .env and fill in. Never put real secrets in this file — it is committed.

# Azure AI Foundry project endpoint.
# Portal: your project > Overview > "Azure AI Foundry project endpoint"
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=

# Model deployment name (not the model name) from Models + endpoints.
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Required by src/aca.ts (Container Apps management plane).
AZURE_SUBSCRIPTION_ID=

# Optional: only needed if `az login` picks the wrong tenant.
# AZURE_TENANT_ID=
